# Environment for the adapter gems and the `portage` CLI, read by
# Portage::Ucp::Resolver (portage-ucp/lib/portage/ucp/resolver.rb), each
# adapter's exe/, and portage-cli. Fill in only what you use — each adapter is
# independent, and `portage-ucp check` reports the rest as skipped probes rather
# than failing. For `portage`, put it in ~/.portage/.env (see the CLI section);
# the adapter exe/s and `portage-ucp check` read only the real environment.
#
# `.env` is gitignored. Never commit real values.

# --- Shopify (portage-ucp-shopify) -------------------------------------------
# Required: SHOPIFY_SHOP_DOMAIN. Admin and Storefront tokens are each optional;
# every capability family works independently if you only have one.
SHOPIFY_SHOP_DOMAIN=your-shop.myshopify.com
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# --- Wix (portage-ucp-wix) ---------------------------------------------------
WIX_ACCESS_TOKEN=

# --- WooCommerce (portage-ucp-woocommerce) -----------------------------------
# WOOCOMMERCE_CURRENCY is optional, defaults to USD.
WOOCOMMERCE_SITE_URL=
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=
WOOCOMMERCE_CURRENCY=

# --- BigCommerce (portage-ucp-bigcommerce) -----------------------------------
# BIGCOMMERCE_CURRENCY is optional, defaults to USD.
BIGCOMMERCE_STORE_HASH=
BIGCOMMERCE_CLIENT_ID=
BIGCOMMERCE_ACCESS_TOKEN=
BIGCOMMERCE_SITE_URL=
BIGCOMMERCE_CURRENCY=

# --- Magento (portage-ucp-magento) -------------------------------------------
# Required: MAGENTO_BASE_URL. Token and currency are optional (currency
# defaults to USD).
MAGENTO_BASE_URL=
MAGENTO_ADMIN_TOKEN=
MAGENTO_CURRENCY=

# --- Etsy (portage-ucp-etsy) -------------------------------------------------
ETSY_ACCESS_TOKEN=
ETSY_API_KEY=
ETSY_SHOP_ID=

# --- Instagram / Facebook Shops (portage-ucp-instagram) ----------------------
META_ACCESS_TOKEN=
META_CATALOG_ID=

# --- Portage CLI (portage-cli) ------------------------------------------------
# `portage` and `portage-console` load ~/.portage/.env on startup, so copy the
# lines you need there (`chmod 600` it: `portage doctor` warns if others can
# read it). Variables already set in your shell win, and empty values are
# skipped.
#
# SAFETY: a ./.env in the current directory is NEVER loaded automatically.
# Otherwise running `portage` inside any cloned repo would silently apply that
# repo's proxy (PORTAGE_PROXY/PORTAGE_PROXY_CA can intercept store traffic),
# notify webhooks or store credentials. To use this checkout's file, opt in
# explicitly after reading it: PORTAGE_ENV_FILE=.env portage ...

# Shipping address. `portage doctor` warns until the four required ones are
# set. COUNTRY/REGION/POSTAL_CODE (with CURRENCY and LANGUAGE) are also sent to
# native UCP stores as buyer context, which picks the market a store prices and
# stocks in: without at least PORTAGE_SHIP_COUNTRY, a live Shopify store can
# report in-stock items as out of stock. The full address goes to your own
# store's checkout (adapter fallback) as the shipping destination.
# Required:
PORTAGE_SHIP_STREET=
PORTAGE_SHIP_CITY=
PORTAGE_SHIP_COUNTRY=
PORTAGE_SHIP_POSTAL_CODE=
# Optional:
PORTAGE_SHIP_EXTENDED=
PORTAGE_SHIP_REGION=
PORTAGE_SHIP_FIRST_NAME=
PORTAGE_SHIP_LAST_NAME=
PORTAGE_SHIP_PHONE=
PORTAGE_CURRENCY=
PORTAGE_LANGUAGE=

# Search backends for `portage find` / URL-less `portage buy`. DuckDuckGo is
# the keyless default but only resolves brand/entity names; set one of these
# for category queries, or list stores you trust in PORTAGE_STORES
# (comma-separated URLs, same as ~/.portage/stores.yml).
BRAVE_SEARCH_API_KEY=
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=
PORTAGE_STORES=

# Required for `portage find`/`buy` against a real, external UCP store (native
# UCP over HTTP) — not needed for your own store via an adapter. Real UCP
# servers fetch this URL themselves to verify the calling agent's identity
# before answering any catalog/cart/checkout call; without it every such call
# fails with "Set PORTAGE_AGENT_PROFILE...". See docs/agent-profile.md for how
# this repo generates and hosts one (`portage generate agent-profile`). Served
# via jsdelivr's GitHub CDN mirror rather than raw.githubusercontent.com or
# GitHub Pages — confirmed live against a real Shopify UCP store (billabong.com,
# 2026-09-17): raw.githubusercontent.com serves this path as `text/plain`, which
# a strict UCP server rejects as `profile_malformed`; jsdelivr serves the same
# checked-in file as `application/json` with no redirect and a long
# `Cache-Control: public, max-age=604800`. GitHub Pages needs Actions minutes
# this account's billing doesn't have enabled, and the checked-in profile is
# public either way.
#
# That week-long cache is on the `@main` alias, so **after every change to
# agent-profile.json, purge it** or the CDN keeps serving the old document for
# up to seven days — which is not a stale-doc nuisance but the exact
# `Tool not found` failure the profile fix was for, reappearing with correct
# code in the repo (hit live 2026-09-22, days after the fix landed):
#
#   curl -s https://purge.jsdelivr.net/gh/tomtom87/Portage@main/portage-cli/agent-profile/agent-profile.json
#
# Pin `@<full-sha>` instead of `@main` if you'd rather never think about it:
# jsdelivr treats a sha path as immutable, so it can't go stale, at the cost
# of editing this line whenever the profile changes.
PORTAGE_AGENT_PROFILE=https://cdn.jsdelivr.net/gh/tomtom87/Portage@main/portage-cli/agent-profile/agent-profile.json
