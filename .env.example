# Credentials for the adapter gems, read from the process environment by
# Portage::Ucp::Resolver (portage-ucp/lib/portage/ucp/resolver.rb) and by each
# adapter's exe/. Copy to `.env` and fill in only the platforms you use — each
# adapter is independent, and `portage-ucp check` reports the rest as skipped
# probes rather than failing.
#
# `.env` is gitignored. Never commit real values.

# --- Shopify (portage-ucp-shopify) -------------------------------------------
# Required: SHOPIFY_SHOP_DOMAIN. Admin and Storefront tokens are each optional;
# every capability family works independently if you only have one.
SHOPIFY_SHOP_DOMAIN=your-shop.myshopify.com
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# --- Wix (portage-ucp-wix) ---------------------------------------------------
WIX_ACCESS_TOKEN=

# --- WooCommerce (portage-ucp-woocommerce) -----------------------------------
# WOOCOMMERCE_CURRENCY is optional, defaults to USD.
WOOCOMMERCE_SITE_URL=
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=
WOOCOMMERCE_CURRENCY=

# --- BigCommerce (portage-ucp-bigcommerce) -----------------------------------
# BIGCOMMERCE_CURRENCY is optional, defaults to USD.
BIGCOMMERCE_STORE_HASH=
BIGCOMMERCE_CLIENT_ID=
BIGCOMMERCE_ACCESS_TOKEN=
BIGCOMMERCE_SITE_URL=
BIGCOMMERCE_CURRENCY=

# --- Magento (portage-ucp-magento) -------------------------------------------
# Required: MAGENTO_BASE_URL. Token and currency are optional (currency
# defaults to USD).
MAGENTO_BASE_URL=
MAGENTO_ADMIN_TOKEN=
MAGENTO_CURRENCY=

# --- Etsy (portage-ucp-etsy) -------------------------------------------------
ETSY_ACCESS_TOKEN=
ETSY_API_KEY=
ETSY_SHOP_ID=

# --- Instagram / Facebook Shops (portage-ucp-instagram) ----------------------
META_ACCESS_TOKEN=
META_CATALOG_ID=
