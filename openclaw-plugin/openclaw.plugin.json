{
  "id": "portage",
  "name": "Portage",
  "description": "Search, compare and buy from online stores through the Portage CLI, with spending policy and per-payment approval enforced by Portage itself.",
  "categories": [
    "integrations"
  ],
  "contracts": {
    "tools": [
      "portage_doctor",
      "portage_find",
      "portage_find_store",
      "portage_check",
      "portage_compare",
      "portage_index_search",
      "portage_index_show",
      "portage_index_sources",
      "portage_history",
      "portage_orders_reconcile",
      "portage_policy_show",
      "portage_payment_list",
      "portage_browser_profile_status",
      "portage_pick",
      "portage_dry_run",
      "portage_approve",
      "portage_buy_quote",
      "portage_handoff",
      "portage_index_add",
      "portage_index_remove",
      "portage_index_build",
      "portage_index_refresh",
      "portage_browser_import"
    ]
  },
  "toolMetadata": {
    "portage_pick": {
      "optional": true,
      "sideEffecting": true
    },
    "portage_dry_run": {
      "optional": true,
      "sideEffecting": true
    },
    "portage_approve": {
      "optional": true,
      "sideEffecting": true
    },
    "portage_buy_quote": {
      "optional": true,
      "sideEffecting": true
    },
    "portage_handoff": {
      "optional": true,
      "sideEffecting": true
    },
    "portage_index_add": {
      "optional": true,
      "sideEffecting": true
    },
    "portage_index_remove": {
      "optional": true,
      "sideEffecting": true
    },
    "portage_index_build": {
      "optional": true,
      "sideEffecting": true
    },
    "portage_index_refresh": {
      "optional": true,
      "sideEffecting": true
    },
    "portage_browser_import": {
      "optional": true,
      "sideEffecting": true
    }
  },
  "activation": {
    "onStartup": true
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "portageBin": {
        "type": "string",
        "minLength": 1,
        "default": "portage",
        "pattern": "(^|[/\\\\])portage(\\.exe)?$",
        "description": "Path or name of the portage executable (default: portage on PATH). Must be portage itself, or a path ending in /portage: the plugin runs nothing else."
      },
      "timeoutSeconds": {
        "type": "number",
        "exclusiveMinimum": 0,
        "default": 120,
        "description": "Per-call timeout in seconds."
      }
    }
  },
  "skills": [
    "skills"
  ]
}
