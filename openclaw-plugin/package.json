{
  "name": "@tomtom87/portage",
  "version": "0.10.4",
  "description": "OpenClaw plugin exposing the Portage agentic-commerce CLI as typed tools.",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "skills",
    "openclaw.plugin.json"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/copy-skills.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.5.28",
      "minGatewayVersion": "2026.5.28"
    },
    "build": {
      "openclawVersion": "2026.9.7",
      "pluginSdkVersion": "2026.9.7"
    }
  },
  "dependencies": {
    "typebox": "1.3.34"
  },
  "peerDependencies": {
    "openclaw": ">=2026.5.28"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "openclaw": "2026.9.7",
    "typescript": "^5.6.0",
    "vitest": "^5.0.3"
  }
}
