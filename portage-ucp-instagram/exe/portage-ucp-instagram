#!/usr/bin/env ruby
# frozen_string_literal: true

# Standalone MCP server over stdio. Configure the catalog connection via env
# vars, and — since this gem ships with permissive-nothing defaults (see
# README's "Security hooks") — wire a real Authenticator/RateLimiter/etc. via
# a config file loaded with PORTAGE_UCP_CONFIG, the same way `rackup -r` or
# Sidekiq's `-r` work — see ../examples/portage_ucp.rb for a starting point.
# Without one, the server still starts but rejects every mutating call.
#
# Only INSTAGRAM_ACCESS_TOKEN is read here, not client_id/client_secret/
# short_lived_token: this exe expects a long-lived Page/catalog token you've
# already fetched (e.g. via `bundle exec rake instagram_access_token`) and
# refresh out-of-band, same as any other long-lived process holding a token
# with an expiry.

require "portage/ucp"
require "portage/ucp/instagram"

require ENV["PORTAGE_UCP_CONFIG"] if ENV["PORTAGE_UCP_CONFIG"]

client = Portage::Ucp::Instagram::Client.new(access_token: ENV.fetch("INSTAGRAM_ACCESS_TOKEN"))
adapter = Portage::Ucp::Instagram::Adapter.new(client: client, catalog_id: ENV.fetch("INSTAGRAM_CATALOG_ID"))

server = Portage::Ucp::Mcp::Server.build(adapter: adapter)
MCP::Server::Transports::StdioTransport.new(server).open
