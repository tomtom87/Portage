require "bundler/gem_tasks"
require "rspec/core/rake_task"

RSpec::Core::RakeTask.new(:spec)

task default: :spec

desc "Exchange MAGENTO_USERNAME/PASSWORD for an admin bearer token (MAGENTO_BASE_URL)"
task :magento_access_token do
  require_relative "lib/portage/ucp/magento"

  result = Portage::Ucp::Magento::AccessTokenFetcher.new(
    base_url: ENV.fetch("MAGENTO_BASE_URL"),
    username: ENV.fetch("MAGENTO_USERNAME"),
    password: ENV.fetch("MAGENTO_PASSWORD")
  ).fetch

  puts "admin_token: #{result.access_token}"
  puts "expires_in: not reported by Magento — refresh on 401 rather than a known lifetime"
end
