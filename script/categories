#!/usr/bin/env ruby
# frozen_string_literal: true

# Regenerates portage-cli/known-stores/categories.yml, the keyword table
# Portage::Cli::Classifier matches text against (docs/plans/local-catalogue.md,
# Phase 5).
#
# Usage: script/categories [--from FILE] [--out PATH]
#
# Reads Google's product taxonomy ("taxonomy-with-ids.en-US.txt"): fetched from
# google.com, or from FILE. The edition is pinned in the output header, so a
# newer Google file changes the data only when someone runs this on purpose.
#
# Output: the top two levels of the taxonomy as keys, in the taxonomy's own
# order (Google's numeric ids as strings, so ~/.portage/categories.yml can
# override or extend a node by id).
#
# - `keywords`: the node's own name words, plus, for a level-2 node, the words
#   of every descendant (levels 3 and up), so "Chandeliers" counts for
#   Home & Garden > Lighting. Plus the node's synonyms.
# - `parent_keywords`: a level-2 node's parent name words ("home", "garden"),
#   which say less about the product and score less.
#
# Words on known-stores/category-stoplist.yml never become keywords.
# known-stores/category-synonyms.yml adds the few words the taxonomy lacks.
#
# Stdlib only (net/http, yaml, optparse), like script/homebrew-formula, so it
# runs as `ruby script/categories` with no Bundler.

require "net/http"
require "optparse"
require "uri"
require "yaml"

module CategoriesGenerator
  ROOT = File.expand_path("..", __dir__)
  KNOWN_STORES = File.join(ROOT, "portage-cli", "known-stores")
  TAXONOMY_URL = "https://www.google.com/basepages/producttype/taxonomy-with-ids.en-US.txt"
  # Below three letters a word is noise, as in Classifier::MIN_WORD_LENGTH.
  MIN_WORD_LENGTH = 3
  VERSION_LINE = /\A#\s*Google_Product_Taxonomy_Version:\s*(\S+)/

  Node = Struct.new(:id, :path, keyword_init: true)

  module_function

  # @return [Array(String, Array<Node>)] the taxonomy edition and its nodes,
  #   in file order.
  def parse(text)
    version = nil
    nodes = []
    text.each_line do |line|
      line = line.strip
      version ||= line[VERSION_LINE, 1]
      next if line.empty? || line.start_with?("#")

      id, path = line.split(" - ", 2)
      nodes << Node.new(id: id, path: path.split(" > ").map(&:strip))
    end
    raise "no Google_Product_Taxonomy_Version line in the taxonomy file" unless version

    [version, nodes]
  end

  # @param stoplist [Hash{String => String}] word => why it is ignored.
  # @param synonyms [Hash{String => Hash{String => String}}] node id =>
  #   { word => why it is there }.
  # @return [String] the categories.yml text.
  def generate(text, stoplist: {}, synonyms: {})
    version, nodes = parse(text)
    table = top_two_levels(nodes).to_h do |node|
      [node.id, entry(node, nodes, stoplist, synonyms.fetch(node.id, {}))]
    end
    header(version) + YAML.dump(table).delete_prefix("---\n")
  end

  def top_two_levels(nodes) = nodes.select { |node| node.path.length <= 2 }

  def entry(node, nodes, stoplist, synonyms)
    keywords = words(node.path.last, stoplist)
    keywords |= descendants(node, nodes).flat_map { |other| words(other.path.last, stoplist) } if node.path.length == 2
    keywords |= synonyms.keys.map(&:downcase)
    result = { "name" => node.path.join(" > "), "keywords" => keywords }
    parents = node.path.length == 2 ? words(node.path.first, stoplist) - keywords : []
    result["parent_keywords"] = parents unless parents.empty?
    result
  end

  # Levels 3 and up under a level-2 node, in taxonomy order.
  def descendants(node, nodes)
    nodes.select { |other| other.path.length > 2 && other.path.first(2) == node.path }
  end

  def words(name, stoplist)
    name.downcase.split(/[^\p{Alpha}]+/).select { |word| word.length >= MIN_WORD_LENGTH }
        .reject { |word| stoplist.key?(word) }.uniq
  end

  def header(version)
    <<~HEADER
      # Generated by script/categories from the Google Product Taxonomy, edition #{version}
      # (#{TAXONOMY_URL}).
      # Do not edit by hand: change category-stoplist.yml or category-synonyms.yml and run
      # script/categories again.
      #
      # Top two levels only. Keys are Google's own numeric category ids as strings; keep
      # them, they are how ~/.portage/categories.yml overrides (same id) or extends (a new
      # id) a node. `keywords` are the node's own name words plus, for a level-2 node, its
      # descendants' (levels 3 and up); `parent_keywords` are its parent's. Both are matched
      # whole-word by Classifier (which also normalizes simple plurals), keywords scoring 2
      # and parent_keywords 1.
    HEADER
  end

  def load_yaml(path)
    File.exist?(path) ? YAML.safe_load_file(path, permitted_classes: []) || {} : {}
  end

  def fetch(url)
    response = Net::HTTP.get_response(URI(url))
    raise "GET #{url} failed: #{response.code} #{response.message}" unless response.is_a?(Net::HTTPSuccess)

    response.body.dup.force_encoding(Encoding::UTF_8)
  end

  def main(argv)
    from = nil
    out = File.join(KNOWN_STORES, "categories.yml")
    OptionParser.new do |opts|
      opts.on("--from FILE", "Read the taxonomy from FILE instead of fetching it") { |v| from = v }
      opts.on("--out PATH", "Write here instead of known-stores/categories.yml (use - for stdout)") { |v| out = v }
    end.parse!(argv)

    text = from ? File.read(from, encoding: "UTF-8") : fetch(TAXONOMY_URL)
    yaml = generate(text, stoplist: load_yaml(File.join(KNOWN_STORES, "category-stoplist.yml")),
                          synonyms: load_yaml(File.join(KNOWN_STORES, "category-synonyms.yml")))
    out == "-" ? $stdout.write(yaml) : File.write(out, yaml)
  end
end

CategoriesGenerator.main(ARGV) if $PROGRAM_NAME == __FILE__
