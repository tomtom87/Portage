# frozen_string_literal: true

# Generated by script/homebrew-formula in tomtom87/Portage — do not
# hand-edit. Re-run that script after releasing portage-cli or any bundled
# adapter/webmcp/decision gem.
class Portage < Formula
  desc "One CLI command to buy from any store, native UCP or not"
  homepage "https://github.com/tomtom87/Portage"
  url "<%= gem_url(MAIN_GEM, main.version) %>"
  sha256 "<%= main.sha256 %>"
  license "MIT"

  depends_on "ruby"

<% resources.each do |name, gem| -%>
  resource "<%= name %>" do
    url "<%= gem_url(name, gem.version) %>"
    sha256 "<%= gem.sha256 %>"
  end

<% end -%>
  def install
    ENV["GEM_HOME"] = libexec
    ENV["GEM_PATH"] = libexec

    resources.each do |r|
      r.stage do
        system "gem", "install", Dir["*.gem"].first,
               "--install-dir", libexec, "--no-document", "--ignore-dependencies"
      end
    end

    system "gem", "install", cached_download,
           "--install-dir", libexec, "--no-document", "--ignore-dependencies"

    bin.install libexec/"bin/portage"
    bin.install libexec/"bin/portage-console"
    bin.env_script_all_files(libexec/"bin", GEM_HOME: libexec, GEM_PATH: libexec)
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/portage --version").strip

    # `doctor` never touches the network (it only inspects local
    # Portage::Ucp::Configuration), so this exercises a full offline load
    # of portage-cli plus every bundled gem without a store or network
    # fixture. Findings are non-empty on a freshly installed config (no
    # authenticator/rate_limiter/signing keys set up yet), hence exit 1.
    output = shell_output("#{bin}/portage doctor --json", 1)
    findings = JSON.parse(output)
    assert_kind_of Array, findings
    refute_predicate findings, :empty?
  end
end
