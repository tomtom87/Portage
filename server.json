{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.tomtom87/portage",
  "title": "Portage",
  "description": "Shopify catalog search and product lookup via MCP; the Portage CLI adds full agentic buying.",
  "repository": {
    "url": "https://github.com/tomtom87/Portage",
    "source": "github"
  },
  "websiteUrl": "https://portage.readthedocs.io",
  "version": "0.16.0",
  "packages": [
    {
      "registryType": "oci",
      "identifier": "ghcr.io/tomtom87/portage-ucp:0.16.0",
      "transport": { "type": "stdio" },
      "environmentVariables": [
        { "name": "SHOPIFY_SHOP_DOMAIN", "description": "Your shop, e.g. your-shop.myshopify.com", "isRequired": true },
        { "name": "SHOPIFY_STOREFRONT_ACCESS_TOKEN", "description": "Storefront API access token", "isRequired": true, "isSecret": true },
        { "name": "SHOPIFY_ADMIN_ACCESS_TOKEN", "description": "Admin API access token (optional)", "isSecret": true }
      ]
    }
  ]
}
